<odoo>
    <record id="hr_hospital_visit_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.visit.list</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="planned_date"/>
                <field name="visit_date"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="disease_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_visit_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_disease_visits" type="object"
                                class="oe_stat_button" icon="fa-heartbeat"
                                invisible="not disease_id">
                            <field name="disease_visit_count" widget="statinfo"
                                   string="Same Disease"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="planned_date"/>
                            <field name="visit_date"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="doctor_id"/>
                            <field name="patient_id"/>
                            <field name="disease_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="summary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_view_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visits"
                      date_start="planned_date"
                      color="doctor_id"
                      mode="month"
                      quick_create="0">
                <field name="patient_id"/>
                <field name="disease_id"/>
                <field name="state"/>
                <field name="doctor_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="hr_hospital_visit_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.search</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="name"/>
                <separator/>
                <filter name="filter_planned" string="Planned"
                        domain="[('state', '=', 'planned')]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_planned_date" string="Planned Date"
                        date="planned_date" default_period="year"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_doctor" string="Doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_by_disease" string="Disease"
                            context="{'group_by': 'disease_id'}"/>
                    <filter name="group_by_planned_month" string="Planned Month"
                            context="{'group_by': 'planned_date:month'}"/>
                </group>
                <searchpanel>
                    <field name="doctor_id" icon="fa-user-md"
                           enable_counters="1"/>
                    <field name="disease_id" icon="fa-heartbeat"
                           hierarchize="1" expand="1" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="hr_hospital_visit_view_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.pivot</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Analysis" sample="1">
                <field name="doctor_id" type="row"/>
                <field name="planned_date" interval="month" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="hr_hospital_visit_view_graph" model="ir.ui.view">
        <field name="name">hr.hospital.visit.graph</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits by Month" type="bar" stacked="1" sample="1">
                <field name="planned_date" interval="month" type="row"/>
                <field name="disease_id" type="col"/>
            </graph>
        </field>
    </record>

    <record id="hr_hospital_visit_action" model="ir.actions.act_window">
        <field name="name">Візити</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="hr_hospital_visit_analysis_action" model="ir.actions.act_window">
        <field name="name">Аналіз візитів</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_filter_planned_date': 1}</field>
    </record>

    <menuitem id="hr_hospital_visit_menu"
              action="hr_hospital_visit_action"
              parent="hr_hospital_menu_root"
              name="Візити" sequence="400"/>

    <menuitem id="hr_hospital_visit_analysis_menu"
              action="hr_hospital_visit_analysis_action"
              parent="hr_hospital_menu_root"
              name="Аналіз візитів" sequence="410"/>

</odoo>
