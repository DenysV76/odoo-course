<odoo>
    <record id="hr_hospital_patient_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.list</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="personal_doctor_id"/>
                <field name="age"/>
                <field name="blood_type" optional="show"/>
                <field name="insurance_number" optional="hide"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!--
                        Quick visit creation (task 6). Chosen: a type="object" button whose method
                        returns an act_window with target "new" and default_patient_id in its context;
                        the new visit form reads that default_* key, so the patient is pre-filled.
                        Considered: a type="action" button on a separate XML action with
                        context="{'default_patient_id': id}" - it works too, but splits the behaviour
                        between two records, while the method keeps it in one testable place that the
                        doctor kanban reuses. quick_create was rejected: it only creates records of the
                        kanban's own model, not visits.
                    -->
                    <button name="action_create_visit" type="object"
                            string="New Visit" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone" widget="phone"/>
                            <field name="personal_doctor_id"/>
                            <field name="insurance_number"/>
                            <field name="description"/>
                        </group>
                        <group string="Medical Info">
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal Doctor History" name="doctor_history">
                            <field name="doctor_history_ids">
                                <list editable="bottom">
                                    <field name="doctor_id"/>
                                    <field name="assign_date"/>
                                    <field name="change_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name or Phone"
                       filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="personal_doctor_id"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_personal_doctor" string="Personal Doctor"
                            context="{'group_by': 'personal_doctor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Пацієнти</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_patient_menu"
              action="hr_hospital_patient_action"
              parent="hr_hospital_menu_root"
              name="Пацієнти" sequence="100"/>

</odoo>
