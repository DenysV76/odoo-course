<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qa_functional_area_view_list" model="ir.ui.view">
        <field name="name">qa.functional.area.list</field>
        <field name="model">qa.functional.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="display_name" string="Area"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="qa_functional_area_view_form" model="ir.ui.view">
        <field name="name">qa.functional.area.form</field>
        <field name="model">qa.functional.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="description" placeholder="What this area covers..."/>
                    <field name="child_ids" invisible="parent_id">
                        <list>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qa_functional_area_action" model="ir.actions.act_window">
        <field name="name">Functional Areas</field>
        <field name="res_model">qa.functional.area</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="qa_functional_area_menu"
              action="qa_functional_area_action"
              parent="qa_test_management_menu_configuration"
              sequence="10"/>
</odoo>
