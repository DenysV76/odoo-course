<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qa_test_run_view_list" model="ir.ui.view">
        <field name="name">qa.test.run.list</field>
        <field name="model">qa.test.run</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-danger="verdict == 'fail'" decoration-success="verdict == 'pass'">
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id" optional="hide"/>
                <field name="tester_id" widget="many2one_avatar_user"/>
                <field name="date_start" optional="show"/>
                <field name="line_count" sum="Total"/>
                <field name="pass_count" sum="Total" optional="show"/>
                <field name="fail_count" sum="Total" optional="show"/>
                <field name="pass_rate" widget="progressbar" optional="show"/>
                <field name="verdict" widget="badge" decoration-success="verdict == 'pass'" decoration-danger="verdict == 'fail'"/>
                <field name="state" widget="badge" decoration-info="state == 'in_progress'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="qa_test_run_view_form" model="ir.ui.view">
        <field name="name">qa.test.run.form</field>
        <field name="model">qa.test.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'in_progress')"/>
                    <button name="%(qa_test_management.qa_retest_wizard_action)d" type="action" string="Retest Failed" invisible="state != 'done' or not fail_count"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Pass" bg_color="text-bg-success" invisible="state != 'done' or verdict != 'pass'"/>
                    <widget name="web_ribbon" title="Fail" bg_color="text-bg-danger" invisible="state != 'done' or verdict != 'fail'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="task_id" readonly="state != 'draft'"/>
                            <field name="project_id"/>
                            <field name="tester_id" widget="many2one_avatar_user" readonly="state in ('done', 'cancel')"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="estimate_minutes"/>
                            <field name="verdict" invisible="not verdict"/>
                        </group>
                    </group>
                    <group col="5" string="Results">
                        <field name="line_count"/>
                        <field name="pass_count"/>
                        <field name="fail_count"/>
                        <field name="todo_count"/>
                        <field name="pass_rate" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Test Cases" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" decoration-success="result == 'pass'" decoration-danger="result == 'fail'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="case_id" readonly="parent.state != 'draft'"/>
                                    <field name="area_id" optional="show"/>
                                    <field name="priority" widget="priority" optional="hide"/>
                                    <field name="comment"/>
                                    <field name="result" readonly="parent.state != 'in_progress'"/>
                                    <button name="action_set_pass" type="object" icon="fa-check" title="Pass" class="text-success" invisible="parent.state != 'in_progress' or result == 'pass'"/>
                                    <button name="action_set_fail" type="object" icon="fa-times" title="Fail" class="text-danger" invisible="parent.state != 'in_progress' or result == 'fail'"/>
                                    <field name="executed_by_id" widget="many2one_avatar_user" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments" name="note">
                            <field name="note" placeholder="Environment, build, anything that matters for this run..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="qa_test_run_view_kanban" model="ir.ui.view">
        <field name="name">qa.test.run.kanban</field>
        <field name="model">qa.test.run</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false" group_delete="false" group_edit="false" records_draggable="false">
                <field name="verdict"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="verdict" widget="badge" invisible="not verdict" decoration-success="verdict == 'pass'" decoration-danger="verdict == 'fail'"/>
                        </div>
                        <field name="task_id"/>
                        <div class="d-flex justify-content-between mt-2">
                            <span>
                                <field name="pass_count"/> / <field name="line_count"/> passed
                            </span>
                            <field name="tester_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="qa_test_run_view_search" model="ir.ui.view">
        <field name="name">qa.test.run.search</field>
        <field name="model">qa.test.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="tester_id"/>
                <filter name="filter_my" string="My Runs" domain="[('tester_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_open" string="Open" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <filter name="filter_failed" string="Failed" domain="[('verdict', '=', 'fail')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_tester" string="Tester" context="{'group_by': 'tester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="qa_test_run_action" model="ir.actions.act_window">
        <field name="name">Test Runs</field>
        <field name="res_model">qa.test.run</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="qa_test_run_menu"
              action="qa_test_run_action"
              parent="qa_test_management_menu_testing"
              sequence="10"/>
</odoo>
