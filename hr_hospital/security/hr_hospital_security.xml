<odoo>

    <!-- Section in Settings > Users: one category with one privilege holding the whole ladder. -->
    <record id="module_category_hospital" model="ir.module.category">
        <field name="name">Hospital</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_hospital" model="res.groups.privilege">
        <field name="name">Hospital</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_hospital"/>
    </record>

    <!-- Group ladder: every group implies the previous one, Patient -> ... -> Administrator. -->
    <record id="group_hospital_patient" model="res.groups">
        <field name="name">Patient</field>
        <field name="comment">Sees only own visits and own patient card.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hospital_intern" model="res.groups">
        <field name="name">Intern</field>
        <field name="comment">Reads and edits own visits.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_patient'))]"/>
    </record>

    <record id="group_hospital_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="comment">Reads and edits own visits and visits of own interns.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_intern'))]"/>
    </record>

    <record id="group_hospital_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Sees all visits and manages master data, cannot delete.</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_doctor'))]"/>
    </record>

    <record id="group_hospital_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Full access including deletion of any data of the module.</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_hospital_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!--
        Record rules. ACL (ir.model.access.csv) decides WHICH operations a group may do on a
        model; these rules only narrow down WHICH records. Rules of the groups a user belongs
        to are combined with OR, so every group gets an explicit rule, even "all records".
    -->

    <!-- Visits -->
    <record id="hr_hospital_visit_rule_patient" model="ir.rule">
        <field name="name">Visit: patient sees own visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_patient'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_intern" model="ir.rule">
        <field name="name">Visit: intern reads and edits own visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_intern'))]"/>
    </record>

    <record id="hr_hospital_visit_rule_doctor" model="ir.rule">
        <field name="name">Visit: doctor reads and edits own visits and visits of own interns</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_doctor'))]"/>
    </record>

    <record id="hr_hospital_visit_rule_manager" model="ir.rule">
        <field name="name">Visit: manager sees all visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_manager'))]"/>
    </record>

    <record id="hr_hospital_visit_rule_admin" model="ir.rule">
        <field name="name">Visit: administrator has all visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_admin'))]"/>
    </record>

    <!-- Patients: a patient sees only own card, medical staff sees all patients. -->
    <record id="hr_hospital_patient_rule_patient" model="ir.rule">
        <field name="name">Patient: patient sees own card</field>
        <field name="model_id" ref="model_hr_hospital_patient"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_patient'))]"/>
    </record>

    <record id="hr_hospital_patient_rule_staff" model="ir.rule">
        <field name="name">Patient: medical staff sees all patients</field>
        <field name="model_id" ref="model_hr_hospital_patient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hospital_intern'))]"/>
    </record>

</odoo>
