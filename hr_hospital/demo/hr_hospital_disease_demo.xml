<odoo>

    <record id="hr_hospital_disease_infectious" model="hr.hospital.disease">
        <field name="name">Infectious Diseases</field>
    </record>

    <record id="hr_hospital_disease_viral" model="hr.hospital.disease">
        <field name="name">Viral Infections</field>
        <field name="parent_id" ref="hr_hospital_disease_infectious"/>
    </record>

    <record id="hr_hospital_disease_bacterial" model="hr.hospital.disease">
        <field name="name">Bacterial Infections</field>
        <field name="parent_id" ref="hr_hospital_disease_infectious"/>
    </record>

    <record id="hr_hospital_disease_ari" model="hr.hospital.disease">
        <field name="name">Acute Respiratory Viral Infection</field>
        <field name="parent_id" ref="hr_hospital_disease_viral"/>
    </record>

    <record id="hr_hospital_disease_tonsillitis" model="hr.hospital.disease">
        <field name="name">Tonsillitis</field>
        <field name="parent_id" ref="hr_hospital_disease_bacterial"/>
    </record>

</odoo>
