<odoo>
    <record id="hospital_doctor_history_view_list" model="ir.ui.view">
        <field name="name">hospital.doctor.history.list</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Запис"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assign_date"/>
                <field name="change_date"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hospital_doctor_history_view_form" model="ir.ui.view">
        <field name="name">hospital.doctor.history.form</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="assign_date"/>
                            <field name="change_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_doctor_history_action" model="ir.actions.act_window">
        <field name="name">Історія персональних лікарів</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="hospital_doctor_history_menu"
              action="hospital_doctor_history_action"
              parent="hr_hospital_menu_root"
              name="Історія лікарів" sequence="700"/>

</odoo>
