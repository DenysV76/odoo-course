<odoo>
    <record id="hr_hospital_doctor_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.list</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="is_intern" optional="show"/>
                <field name="mentor_id" invisible="not is_intern" optional="show"/>
                <field name="intern_count" optional="show"/>
                <field name="observing_doctor_id"/>
                <field name="user_id" optional="hide"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_visit" type="object"
                            string="New Visit" class="btn-primary"
                            groups="hr_hospital.group_hospital_intern"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"
                                   domain="[('is_intern', '=', False), ('id', '!=', id)]"/>
                            <field name="observing_doctor_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Medical Info">
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                        <group string="Mentor" invisible="not mentor_id">
                            <field name="mentor_category_id"/>
                            <field name="mentor_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Interns" name="interns" invisible="not intern_ids">
                            <field name="intern_ids" mode="kanban" readonly="1">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name" class="fw-bold"/>
                                            <field name="category_id"/>
                                            <field name="age"/>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_view_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.kanban</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" quick_create="0">
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="category_id"/>
                        <div t-if="record.mentor_id.raw_value" class="text-muted">
                            Mentor: <field name="mentor_id"/>
                        </div>
                        <div t-if="record.intern_ids.raw_value.length">
                            <span class="text-muted">Interns:</span>
                            <field name="intern_ids" widget="many2many_tags"/>
                        </div>
                        <footer>
                            <button name="action_create_visit" type="object"
                                    string="New Visit" class="btn btn-sm btn-primary"
                                    groups="hr_hospital.group_hospital_intern"/>
                        </footer>
                    </t>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Open</a>
                        <a t-if="record.active.raw_value" role="menuitem" type="archive"
                           class="dropdown-item">Archive</a>
                        <a t-else="" role="menuitem" type="unarchive"
                           class="dropdown-item">Unarchive</a>
                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_hospital_doctor_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="mentor_id"/>
                <separator/>
                <filter name="filter_mentors" string="Mentors"
                        domain="[('intern_ids', '!=', False)]"/>
                <filter name="filter_interns" string="Interns"
                        domain="[('is_intern', '=', True)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_hospital_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="hr_hospital_doctor_menu"
              action="hr_hospital_doctor_action"
              parent="hr_hospital_menu_root"
              name="Doctors" sequence="200"/>

</odoo>
