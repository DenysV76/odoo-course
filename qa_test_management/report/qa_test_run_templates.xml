<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="qa_test_run_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <!-- external_layout adds the company header and footer on every page -->
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Test Run <span t-field="run.name"/></h2>

                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Task:</strong> <span t-field="run.task_id"/><br/>
                                <strong>Project:</strong> <span t-field="run.project_id"/><br/>
                                <strong>Tester:</strong> <span t-field="run.tester_id"/>
                            </div>
                            <div class="col-6">
                                <strong>State:</strong> <span t-field="run.state"/><br/>
                                <strong>Started:</strong> <span t-field="run.date_start"/><br/>
                                <strong>Finished:</strong> <span t-field="run.date_end"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Cases</th>
                                    <th>Passed</th>
                                    <th>Failed</th>
                                    <th>Not Executed</th>
                                    <th>Pass Rate</th>
                                    <th>Verdict</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="run.line_count"/></td>
                                    <td><span t-field="run.pass_count"/></td>
                                    <td><span t-field="run.fail_count"/></td>
                                    <td><span t-field="run.todo_count"/></td>
                                    <td><span t-out="round(run.pass_rate)"/> %</td>
                                    <td><strong t-field="run.verdict"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Test Cases</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Test Case</th>
                                    <th>Functional Area</th>
                                    <th>Result</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="run.line_ids" t-as="line">
                                    <td><span t-esc="line_index + 1"/></td>
                                    <td><span t-field="line.case_id"/></td>
                                    <td><span t-field="line.area_id"/></td>
                                    <td>
                                        <span t-if="line.result" t-field="line.result"
                                              t-attf-class="fw-bold {{ 'text-success' if line.result == 'pass' else 'text-danger' }}"/>
                                        <span t-else="" class="text-muted">-</span>
                                    </td>
                                    <td><span t-field="line.comment"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="run.note" class="mt-3">
                            <strong>Comments:</strong>
                            <p t-field="run.note"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
