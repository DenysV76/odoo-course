<odoo>
    <record id="hr_hospital_patient_view_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.list</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="personal_doctor_id"/>
                <field name="age"/>
                <field name="blood_type" optional="show"/>
                <field name="insurance_number" optional="hide"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="personal_doctor_id"/>
                            <field name="insurance_number"/>
                            <field name="description"/>
                        </group>
                        <group string="Medical Info">
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal Doctor History" name="doctor_history">
                            <field name="doctor_history_ids">
                                <list editable="bottom">
                                    <field name="doctor_id"/>
                                    <field name="assign_date"/>
                                    <field name="change_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Пацієнти</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_patient_menu"
              action="hr_hospital_patient_action"
              parent="hr_hospital_menu_root"
              name="Пацієнти" sequence="100"/>

</odoo>
