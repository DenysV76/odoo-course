<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_qa" model="ir.module.category">
        <field name="name">Quality Assurance</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_qa" model="res.groups.privilege">
        <field name="name">QA Test Management</field>
        <field name="category_id" ref="module_category_qa"/>
    </record>

    <record id="group_qa_user" model="res.groups">
        <field name="name">Tester</field>
        <field name="privilege_id" ref="res_groups_privilege_qa"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_qa_admin" model="res.groups">
        <field name="name">QA Lead</field>
        <field name="privilege_id" ref="res_groups_privilege_qa"/>
        <field name="implied_ids" eval="[Command.link(ref('group_qa_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- A tester works on the runs assigned to them; the lead assigns and sees all. -->
    <record id="qa_test_run_rule_tester" model="ir.rule">
        <field name="name">Test Run: tester sees own runs</field>
        <field name="model_id" ref="model_qa_test_run"/>
        <field name="domain_force">[('tester_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_qa_user'))]"/>
    </record>

    <record id="qa_test_run_rule_lead" model="ir.rule">
        <field name="name">Test Run: lead sees all runs</field>
        <field name="model_id" ref="model_qa_test_run"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_qa_admin'))]"/>
    </record>

    <record id="qa_test_run_line_rule_tester" model="ir.rule">
        <field name="name">Test Run Line: tester sees lines of own runs</field>
        <field name="model_id" ref="model_qa_test_run_line"/>
        <field name="domain_force">[('run_id.tester_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_qa_user'))]"/>
    </record>

    <record id="qa_test_run_line_rule_lead" model="ir.rule">
        <field name="name">Test Run Line: lead sees all lines</field>
        <field name="model_id" ref="model_qa_test_run_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_qa_admin'))]"/>
    </record>
</odoo>
