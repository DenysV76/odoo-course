<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_inherit_qa" model="ir.ui.view">
        <field name="name">project.task.form.inherit.qa</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_qa_runs" type="object" class="oe_stat_button" icon="fa-check-square-o" groups="qa_test_management.group_qa_user">
                    <field name="qa_run_count" widget="statinfo" string="Test Runs"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="QA" name="qa" groups="qa_test_management.group_qa_user">
                    <group>
                        <field name="qa_verdict" widget="badge" decoration-success="qa_verdict == 'pass'" decoration-danger="qa_verdict == 'fail'"/>
                    </group>
                    <field name="qa_requirement_ids" context="{'default_task_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="area_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="case_count"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
