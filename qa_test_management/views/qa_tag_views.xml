<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qa_tag_view_list" model="ir.ui.view">
        <field name="name">qa.tag.list</field>
        <field name="model">qa.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="qa_tag_view_form" model="ir.ui.view">
        <field name="name">qa.tag.form</field>
        <field name="model">qa.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qa_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">qa.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="qa_tag_menu"
              action="qa_tag_action"
              parent="qa_test_management_menu_configuration"
              sequence="20"/>
</odoo>
